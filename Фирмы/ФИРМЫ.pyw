"""
ФИРМЫ — запуск без чёрного окна, как у остальных приложений (.pyw).

ПОЧЕМУ РАНЬШЕ БЫЛ ТОЛЬКО .bat, а у Генератора и Пакера — .pyw.
Файл .pyw открывается СИСТЕМНЫМ pythonw.exe. У Генератора и Пакера все
библиотеки стоят в системном Python, поэтому им этого хватает. У Фирм
библиотеки живут в СВОЁМ окружении (папка .venv): Playwright и браузер к нему
тянут за собой версии, которые не стоит подмешивать в общий Python. Системный
pythonw про .venv не знает — двойной клик по .pyw просто падал бы с
«No module named playwright», причём МОЛЧА: у pythonw нет консоли, и ошибку
никто бы не увидел. Поэтому запуск был через .bat: он и окружение создаёт при
первом запуске, и ошибку показывает.

Этот файл убирает разницу. Он ничего не импортирует сверх стандартной
библиотеки, поэтому спокойно работает на любом системном Python, а само
приложение перезапускает уже правильным pythonw.exe из .venv — без консоли.

Первый запуск (окружения ещё нет) отдаём СТАРТ.bat: установка идёт несколько
минут, и человек должен видеть, что происходит.

СТАРТ.bat при этом НЕ УДАЛЯТЬ: по нему приложение находит корень проекта
(common/пути.py), да и как запасной запуск он полезен.
"""
import subprocess
import sys
from pathlib import Path

КОРЕНЬ = Path(__file__).resolve().parent


def найти_app() -> Path | None:
    """
    Что запускать. Сначала ищем «окно.py» — РАБОЧЕЕ окно: один экран, один
    проход (нашёл → сверил с ботом → выписки → выдача).

    «app.py» — старое окно с четырьмя вкладками и раздельными Частями. Оно
    осталось для починки гео и записи действий, но человеку каждый день нужно
    не оно. Поэтому app.py — запасной вариант, а не главный.
    """
    for имя in ("окно.py", "app.py"):
        if (КОРЕНЬ / имя).exists():
            return КОРЕНЬ / имя
        for папка in sorted(КОРЕНЬ.iterdir()):
            if папка.is_dir() and (папка / имя).exists():
                return папка / имя
    return None


def сказать(текст: str) -> None:
    """Окно с сообщением. Консоли нет — иначе человек не узнает о беде."""
    try:
        import tkinter
        from tkinter import messagebox
        корень = tkinter.Tk()
        корень.withdraw()
        messagebox.showerror("ФИРМЫ", текст)
        корень.destroy()
    except Exception:
        pass


def главное() -> int:
    app = найти_app()
    if app is None:
        сказать("Не нашёл app.py. Проверь, что папка с кодом на месте.")
        return 1

    pythonw = КОРЕНЬ / ".venv" / "Scripts" / "pythonw.exe"
    if not pythonw.exists():
        старт = КОРЕНЬ / "СТАРТ.bat"
        if старт.exists():
            # Первый запуск: пусть ставит с видимой консолью, это долго.
            subprocess.Popen(["cmd", "/c", "start", "", str(старт)], cwd=str(КОРЕНЬ))
            return 0
        сказать("Нет ни окружения (.venv), ни СТАРТ.bat — запустить нечем.")
        return 1

    # ВЫВОД — В ФАЙЛ, и это не роскошь. У pythonw.exe нет консоли, и sys.stdout
    # там равен None: любой оставшийся в коде print() свалил бы приложение
    # молча, без единого следа. С перенаправлением stdout — обычный файл,
    # print работает, а если что-то всё же упадёт, причина останется на диске.
    журнал = КОРЕНЬ / "логи"
    журнал.mkdir(exist_ok=True)
    вывод = open(журнал / "запуск.log", "a", encoding="utf-8", errors="replace")

    # cwd = КОРЕНЬ, ровно как в СТАРТ.bat: от него считаются папки профиля
    # браузера, выписок и логов. Запустишь из другого места — приложение
    # создаст их не там, где все привыкли их искать.
    subprocess.Popen([str(pythonw), str(app)], cwd=str(КОРЕНЬ),
                     stdout=вывод, stderr=вывод)
    return 0


if __name__ == "__main__":
    sys.exit(главное())
