# Под версии идёт ТОЛЬКО код и правила отсева.
# Рабочие данные, состояние и всё тяжёлое — мимо: история должна отвечать на
# вопрос «что я поменял в коде», а не пухнуть от результатов каждого прогона.
#
# Раскладка проекта (см. код/common/пути.py):
#   СТАРТ.bat   запуск, только он
#   код/        весь Python — ЭТО и идёт в git
#   данные/     состояние: реестр, запас слов, исключения, ключи — мимо git
#   фирмы/      рабочие книги Excel — мимо git
#   доки/       описания и заметки — в git
#   выписки/ логи/  результаты прогонов — мимо git

# --- окружение и мусор ---
.venv/
__pycache__/
*.pyc
*.pyo
*.egg-info/

# --- ЖИВОЕ СОСТОЯНИЕ И КЛЮЧИ. Целиком мимо git ---
# Здесь и реестр броней, и запас слов, и исключения, и ключ от Gemini.
# Проще исключить папку целиком, чем перечислять файлы и однажды забыть новый.
данные/

# --- РАБОЧИЕ КНИГИ. Реальные фирмы, растут постоянно ---
фирмы/
*.xlsx
*.xlsm
~$*.xlsx

# --- РЕЗУЛЬТАТЫ ПРОГОНОВ ---
выписки/
логи/
доки/бэкап_до_переноса/

# --- КУКИ И ЛОГИНЫ БРАУЗЕРА. Сюда нельзя ни при каких условиях ---
.профиль_браузера/

# --- прочее ---
*.log
*.tmp
.DS_Store
Thumbs.db
